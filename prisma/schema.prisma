generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Session {
  id            String    @id
  shop          String
  state         String
  isOnline      Boolean   @default(false)
  scope         String?
  expires       DateTime?
  accessToken   String
  userId        BigInt?
  firstName     String?
  lastName      String?
  email         String?
  accountOwner  Boolean   @default(false)
  locale        String?
  collaborator         Boolean?  @default(false)
  emailVerified        Boolean?  @default(false)
  refreshToken         String?
  refreshTokenExpires  DateTime?
}

model Funnel {
  id                String   @id @default(cuid())
  shop              String
  name              String
  status            String   @default("active")
  placement         String
  offerType         String
  triggerProductIds String[]
  offerProductId    String
  offerProductIds   String[]
  offerTitle        String   @default("")
  offerImageUrl     String   @default("")
  offerVariantId    String   @default("")
  offerPrice        Float    @default(0)
  discountCode      String   @default("")
  discountRuleId    String   @default("")
  discountType      String   @default("none")
  discountValue     Float    @default(0)
  minCartValue      Float    @default(0)
  skipSubscribed    Boolean  @default(true)
  priority          Int      @default(0)
  displayStyle      String   @default("carousel")
  widgetTitle       String   @default("")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  impressions       FunnelEvent[]
}

model FunnelEvent {
  id        String   @id @default(cuid())
  funnelId  String
  funnel    Funnel   @relation(fields: [funnelId], references: [id], onDelete: Cascade)
  shop      String
  eventType String
  orderId   String?
  revenue   Float?
  createdAt DateTime @default(now())
}

model ShopSettings {
  id                   String   @id @default(cuid())
  shop                 String   @unique

  // Widget appearance
  widgetPosition       String   @default("bottom-right")
  accentColor          String   @default("#000000")
  borderRadius         Int      @default(8)
  showPoweredBy        Boolean  @default(true)
  buttonColor          String   @default("#1a1a1a")
  buttonTextColor      String   @default("#ffffff")
  widgetBgColor        String   @default("#ffffff")

  // Behavior
  showOnMobile         Boolean  @default(true)
  animationStyle       String   @default("slide")
  autoCloseSeconds     Int      @default(0)

  // Notifications
  emailReports         Boolean  @default(false)
  emailReportFrequency String   @default("weekly")
  notificationEmail    String   @default("")

  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
}
