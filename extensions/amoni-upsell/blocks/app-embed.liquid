{% comment %} Amoni Upsell — injects offer inside cart drawer {% endcomment %}
<div id="amoni-embed-root"
  data-shop="{{ shop.permanent_domain }}"
  data-app-url="https://amoni-upsell-cross-sell.vercel.app"
  style="display:none;"></div>

<script>
(function () {
  var root = document.getElementById('amoni-embed-root');
  if (!root) return;
  var SHOP = root.dataset.shop;
  var APP_URL = root.dataset.appUrl;
  var WIDGET_ID = 'amoni-drawer-offer';
  var cachedFunnel = null;
  var cachedCartHash = '';
  var isInjecting = false;
  var injectTimer = null;

  // ── Toast notification ──
  function showToast(title, imageUrl) {
    var old = document.getElementById('amoni-cart-toast');
    if (old) old.remove();
    if (!document.getElementById('amoni-toast-style')) {
      var s = document.createElement('style');
      s.id = 'amoni-toast-style';
      s.textContent =
        '@keyframes amoniIn{from{opacity:0;transform:translateY(-14px)}to{opacity:1;transform:translateY(0)}}' +
        '@keyframes amoniOut{from{opacity:1}to{opacity:0;transform:translateY(-14px)}}';
      document.head.appendChild(s);
    }
    var t = document.createElement('div');
    t.id = 'amoni-cart-toast';
    t.style.cssText = 'position:fixed;top:20px;right:20px;z-index:2147483647;background:#fff;border-radius:14px;box-shadow:0 8px 32px rgba(0,0,0,0.18);padding:16px 20px;display:flex;align-items:center;gap:14px;max-width:340px;width:calc(100vw - 40px);font-family:inherit;animation:amoniIn 0.3s ease;';
    t.innerHTML =
      (imageUrl ? '<img src="' + imageUrl + '" style="width:52px;height:52px;border-radius:8px;object-fit:cover;flex-shrink:0;" />' : '<div style="width:52px;height:52px;border-radius:8px;background:#f0f0f0;flex-shrink:0;"></div>') +
      '<div style="flex:1;min-width:0;">' +
        '<div style="font-size:13px;color:#888;margin-bottom:2px;">Added to cart</div>' +
        '<div style="font-size:14px;font-weight:600;color:#1a1a1a;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;">' + (title || 'Item') + '</div>' +
        '<div style="display:flex;gap:8px;margin-top:8px;">' +
          '<a href="/cart" style="flex:1;text-align:center;padding:7px 0;background:#1a1a1a;color:#fff;border-radius:8px;font-size:13px;font-weight:600;text-decoration:none;">View cart</a>' +
          '<button id="amoni-toast-close" style="flex:1;padding:7px 0;background:#f3f3f3;color:#333;border:none;border-radius:8px;font-size:13px;font-weight:600;cursor:pointer;">Continue</button>' +
        '</div>' +
      '</div>';
    document.body.appendChild(t);
    document.getElementById('amoni-toast-close').onclick = function () { dismissToast(t); };
    setTimeout(function () { dismissToast(t); }, 5000);
  }
  function dismissToast(t) {
    if (!t || !t.parentNode) return;
    t.style.animation = 'amoniOut 0.3s ease forwards';
    setTimeout(function () { if (t.parentNode) t.remove(); }, 300);
  }

  function refreshBadge() {
    fetch('/cart.js').then(function (r) { return r.json(); }).then(function (cart) {
      checkAndClearDiscount(cart.items);

      // 1. Update badge count
      document.querySelectorAll('cart-count,[data-cart-count],.cart-count,#cart-count,.CartCount,.cart-item-count')
        .forEach(function (b) { b.textContent = cart.item_count; });

      // 2. Shopify global pub/sub — triggers cart-items-component.onCartUpdate() in all modern themes
      if (window.publish && window.PUB_SUB_EVENTS && window.PUB_SUB_EVENTS.cartUpdate) {
        window.publish(window.PUB_SUB_EVENTS.cartUpdate, { source: 'amoni-upsell', cartData: cart });
      }

      // 3. Try component's own refresh/renderContents method
      var cartComp = document.querySelector('cart-items-component');
      if (cartComp) {
        if (typeof cartComp.refresh === 'function') { cartComp.refresh(); return; }
        if (typeof cartComp.renderContents === 'function') { cartComp.renderContents(window.location.href); return; }
        // Trigger onCartUpdate directly if defined
        if (typeof cartComp.onCartUpdate === 'function') { cartComp.onCartUpdate(); return; }
      }

      // 4. Dispatch all known cart events with cart data
      var eventNames = ['cart:refresh','cart:updated','cart:change','theme:cart:add','theme:cart:update','cart-update'];
      eventNames.forEach(function (n) {
        var ev = new CustomEvent(n, { bubbles: true, detail: { cart: cart } });
        document.dispatchEvent(ev);
        window.dispatchEvent(ev);
      });
      if (cartComp) cartComp.dispatchEvent(new CustomEvent('cart:refresh', { bubbles: true, detail: { cart: cart } }));

      // 5. Try Horizon section rendering via cart-items-component data-section-id
      var compEl = document.querySelector('cart-items-component[data-section-id]');
      var rawId = compEl && compEl.dataset.sectionId;
      // Format: "sections--12345__handle" → need both full id and handle
      var sectionHandle = rawId ? rawId.replace(/^[^_]*__/, '') : null;
      var cartSection = null;
      document.querySelectorAll('[id^="shopify-section"]').forEach(function (s) {
        if (!cartSection && s.querySelector('cart-items-component,[class*="cart-drawer__inner"]')) cartSection = s;
      });
      var dynHandle = cartSection ? cartSection.id.replace('shopify-section-', '') : null;
      var tried = {};
      var handles = [sectionHandle, dynHandle, 'cart-drawer', 'cart'].filter(function (h) {
        if (!h || tried[h]) return false; tried[h] = true; return true;
      });
      (function trySection(i) {
        if (i >= handles.length) {
          // 6. Final fallback: close+reopen cart dialog
          var dialog = document.querySelector('.dialog-drawer[open],dialog[open]');
          if (dialog && dialog.open) {
            dialog.close();
            setTimeout(function () {
              var btn = document.querySelector('[aria-controls="cart-drawer"],[data-cart-toggle],[aria-label*="cart" i]:not([class*="close"])');
              if (btn) btn.click();
            }, 250);
          }
          return;
        }
        fetch('/?sections=' + encodeURIComponent(handles[i]))
          .then(function (r) { return r.json(); })
          .then(function (data) {
            var html = data[handles[i]];
            if (!html) { trySection(i + 1); return; }
            var tmp = document.createElement('div');
            tmp.innerHTML = html;
            var sel = '[class*="cart-items_wrapper"],[class*="cart-items-wrapper"],[class*="CartItems"],[class*="cart__items"]';
            var newEl = tmp.querySelector(sel);
            var oldEl = document.querySelector(sel);
            if (newEl && oldEl) { oldEl.innerHTML = newEl.innerHTML; }
            else { trySection(i + 1); }
          }).catch(function () { trySection(i + 1); });
      })(0);

      // 5. Dispatch events with cart data (some themes listen for these)
      var eventNames = ['cart:refresh','cart:updated','cart:change','theme:cart:add','theme:cart:update','cart-update'];
      eventNames.forEach(function (n) {
        var ev = new CustomEvent(n, { bubbles: true, detail: { cart: cart } });
        document.dispatchEvent(ev);
        window.dispatchEvent(ev);
      });
      if (cartComp) cartComp.dispatchEvent(new CustomEvent('cart:refresh', { bubbles: true, detail: { cart: cart } }));
    }).catch(function () {});
  }

  // ── Build a single offer card for the cart drawer carousel ──
  function buildOfferCard(funnel) {
    var offerPrice = parseFloat(funnel.offerPrice) || 0;
    var discounted =
      funnel.discountType === 'percent' ? offerPrice * (1 - (parseFloat(funnel.discountValue) || 0) / 100) :
      funnel.discountType === 'fixed'   ? Math.max(0, offerPrice - (parseFloat(funnel.discountValue) || 0)) : offerPrice;
    var hasDiscount = funnel.discountValue > 0 && discounted < offerPrice;

    var card = document.createElement('div');
    card.style.cssText = 'display:flex;align-items:center;gap:12px;padding:10px;border:1px solid #e8e8e8;border-radius:10px;background:' + cardBgColor + ';flex-shrink:0;min-width:220px;';

    var imgHtml = funnel.offerImageUrl
      ? '<img src="' + funnel.offerImageUrl + '" style="width:60px;height:60px;border-radius:8px;object-fit:cover;border:1px solid #f0f0f0;flex-shrink:0;" />'
      : '<div style="width:60px;height:60px;border-radius:8px;background:#e8e8e8;flex-shrink:0;"></div>';

    var priceHtml = hasDiscount
      ? '<span style="font-size:13px;font-weight:700;color:#1a1a1a;">$' + discounted.toFixed(2) + '</span> <span style="font-size:11px;color:#aaa;text-decoration:line-through;">$' + offerPrice.toFixed(2) + '</span>'
      : '<span style="font-size:13px;font-weight:700;color:#1a1a1a;">$' + discounted.toFixed(2) + '</span>';

    card.innerHTML =
      imgHtml +
      '<div style="flex:1;min-width:0;">' +
        '<div style="font-size:12px;font-weight:600;color:#1a1a1a;overflow:hidden;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;margin-bottom:4px;">' + (funnel.offerTitle || '') + '</div>' +
        '<div style="margin-bottom:6px;">' + priceHtml + '</div>' +
      '</div>' +
      '<button data-amoni-add style="padding:7px 14px;border-radius:20px;border:none;background:' + buttonColor + ';color:' + buttonTextColor + ';font-size:12px;font-weight:600;cursor:pointer;white-space:nowrap;font-family:inherit;flex-shrink:0;">Add</button>';

    var btn = card.querySelector('[data-amoni-add]');
    btn.addEventListener('click', function () {
      if (!funnel.offerVariantId) return;
      btn.textContent = 'Adding...';
      btn.disabled = true;

      var sectionsToFetch = [];
      document.querySelectorAll('[id^="shopify-section"]').forEach(function (el) {
        if (el.querySelector('cart-items-component,[class*="cart-drawer"],[class*="CartDrawer"]')) {
          sectionsToFetch.push(el.id.replace('shopify-section-', ''));
        }
      });
      ['cart-drawer', 'cart-notification'].forEach(function (h) {
        if (sectionsToFetch.indexOf(h) === -1) sectionsToFetch.push(h);
      });

      fetch('/cart/add.js', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          id: parseInt(funnel.offerVariantId, 10),
          quantity: 1,
          sections: sectionsToFetch.join(','),
        }),
      })
        .then(function (r) { if (!r.ok) throw new Error(); return r.json(); })
        .then(function (addData) {
          if (addData.sections) {
            Object.keys(addData.sections).forEach(function (sectionId) {
              var html = addData.sections[sectionId];
              var sectionEl = document.getElementById('shopify-section-' + sectionId);
              if (sectionEl && html) {
                var tmp = document.createElement('div');
                tmp.innerHTML = html;
                var sel = '[class*="cart-items_wrapper"],[class*="cart-items-wrapper"],[class*="CartItems"],[class*="cart__items"],#cart-form,.cart-items';
                var newEl = tmp.querySelector(sel);
                var oldEl = sectionEl.querySelector(sel);
                if (newEl && oldEl) oldEl.innerHTML = newEl.innerHTML;
                else if (newEl) {
                  var newSection = tmp.querySelector('cart-items-component');
                  var oldSection = sectionEl.querySelector('cart-items-component');
                  if (newSection && oldSection) oldSection.innerHTML = newSection.innerHTML;
                }
              }
            });
          }
          if (funnel.discountCode) {
            try { sessionStorage.setItem('amoni_discount', JSON.stringify({ code: funnel.discountCode, variantId: funnel.offerVariantId })); } catch(e) {}
            return fetch('/cart/update.js', {
              method: 'POST', headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ discount: funnel.discountCode }),
            });
          }
        })
        .then(function () {
          btn.textContent = '✓ Added';
          btn.style.background = '#0c8a4f';
          fetch(APP_URL + '/api/events', {
            method: 'POST', headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ funnelId: (funnel.funnelId || funnel.id), shop: SHOP, eventType: 'accept' }),
          });
          refreshBadge();
          cachedCartHash = '';
          // Remove only this card from the carousel; remove entire widget if it was the only card
          var w = document.getElementById(WIDGET_ID);
          if (w) {
            var cards = w.querySelectorAll('[data-amoni-card]');
            if (cards.length <= 1) {
              w.remove();
            } else {
              card.remove();
            }
          }
        })
        .catch(function () { btn.textContent = 'Error'; btn.disabled = false; });
    });

    return card;
  }

  var showPoweredBy = true;
  var buttonColor = '#1a1a1a';
  var buttonTextColor = '#ffffff';
  var widgetBgColor = '#ffffff';
  var widgetTitleColor = '#1a1a1a';
  var cardBgColor = '#ffffff';

  // ── Clear discount if the discounted variant was removed from cart ──
  function checkAndClearDiscount(cartItems) {
    try {
      var stored = sessionStorage.getItem('amoni_discount');
      if (!stored) return;
      var info = JSON.parse(stored);
      var variantIds = (cartItems || []).map(function (i) { return String(i.variant_id); });
      if (variantIds.indexOf(String(info.variantId)) === -1) {
        sessionStorage.removeItem('amoni_discount');
        fetch('/cart/update.js', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ discount: '' }),
        }).catch(function () {});
      }
    } catch (e) {}
  }

  // ── Build widget HTML: carousel of all funnels ──
  function buildWidget(funnels) {
    var firstFunnel = funnels[0];
    var heading =
      firstFunnel.widgetTitle ||
      (firstFunnel.offerType === 'cross-sell' ? 'You might also like' :
       firstFunnel.offerType === 'upsell'     ? 'Upgrade your order'  :
                                                'Frequently bought together');

    var wrapper = document.createElement('div');
    wrapper.id = WIDGET_ID;
    wrapper.style.cssText = 'padding:12px 16px;margin:12px 0;border-top:1px solid #e8e8e8;border-bottom:1px solid #e8e8e8;background:' + widgetBgColor + ';';

    // Heading
    var headingEl = document.createElement('div');
    headingEl.style.cssText = 'font-size:13px;font-weight:700;color:' + widgetTitleColor + ';margin-bottom:10px;';
    headingEl.textContent = heading;
    wrapper.appendChild(headingEl);

    // Carousel container
    var carouselOuter = document.createElement('div');
    carouselOuter.style.cssText = 'position:relative;';

    var track = document.createElement('div');
    track.style.cssText = 'display:flex;gap:10px;overflow-x:auto;scroll-behavior:smooth;scrollbar-width:none;-ms-overflow-style:none;padding-bottom:2px;';

    funnels.forEach(function (f) {
      var card = buildOfferCard(f);
      card.setAttribute('data-amoni-card', f.id);
      track.appendChild(card);
    });
    carouselOuter.appendChild(track);

    // Nav arrows (only if multiple funnels)
    if (funnels.length > 1) {
      var btnStyle = 'position:absolute;top:50%;transform:translateY(-50%);width:28px;height:28px;border-radius:50%;border:1px solid #e8e8e8;background:#fff;cursor:pointer;font-size:12px;box-shadow:0 2px 6px rgba(0,0,0,0.1);z-index:1;padding:0;display:flex;align-items:center;justify-content:center;';
      var leftBtn = document.createElement('button');
      leftBtn.style.cssText = btnStyle + 'left:-4px;';
      leftBtn.innerHTML = '&#9664;';
      leftBtn.addEventListener('click', function () { track.scrollBy({ left: -240, behavior: 'smooth' }); });

      var rightBtn = document.createElement('button');
      rightBtn.style.cssText = btnStyle + 'right:-4px;';
      rightBtn.innerHTML = '&#9654;';
      rightBtn.addEventListener('click', function () { track.scrollBy({ left: 240, behavior: 'smooth' }); });

      carouselOuter.appendChild(leftBtn);
      carouselOuter.appendChild(rightBtn);
    }

    wrapper.appendChild(carouselOuter);

    // Powered by Amoni branding (respect shop setting)
    if (showPoweredBy !== false) {
      var branding = document.createElement('div');
      branding.style.cssText = 'text-align:center;margin-top:10px;padding-top:8px;border-top:1px solid #f0f0f0;';
      branding.innerHTML = '<span style="font-size:10px;color:#ccc;letter-spacing:0.03em;vertical-align:middle;margin-right:4px;">Powered by</span>' +
        '<a href="https://amoni.io" target="_blank" rel="noopener" style="display:inline-block;vertical-align:middle;">' +
          '<img src="' + APP_URL + '/Amoni.png" alt="Amoni" style="height:14px;width:auto;opacity:0.5;vertical-align:middle;" />' +
        '</a>';
      wrapper.appendChild(branding);
    }

    return wrapper;
  }

  // ── Find the cart summary/footer container to insert widget before it ──
  function findFooterAnchor() {
    // Target the summary block (above discount/totals/checkout), not a child element
    return (
      document.querySelector('[class*="cart-drawer__summary"]') ||
      document.querySelector('[class*="cart__summary"]') ||
      document.querySelector('[class*="cart-summary"]') ||
      document.querySelector('[class*="cart-drawer__footer"]') ||
      document.querySelector('[class*="cart__footer"]') ||
      document.querySelector('[class*="cart-footer"]') ||
      document.querySelector('cart-drawer-footer') ||
      document.querySelector('#cart-discount-disclosure')
    );
  }

  // ── Insert widget above the Discount/footer area ──
  function injectIntoDrawer(drawer, funnels) {
    if (isInjecting) return;
    if (document.getElementById(WIDGET_ID)) return;

    var footer = findFooterAnchor();

    // If footer not found yet, bail — MutationObserver will retry
    if (!footer) return;

    isInjecting = true;
    var widget = buildWidget(funnels);

    var footerParent = footer.parentNode;
    footerParent.insertBefore(widget, footer);

    fetch(APP_URL + '/api/events', {
      method: 'POST', headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ funnelId: (funnels[0].funnelId || funnels[0].id), shop: SHOP, eventType: 'impression' }),
    });

    isInjecting = false;
  }

  // ── Fetch funnels and inject ──
  var cachedFunnels = null;
  function fetchAndInject(drawer) {
    fetch('/cart.js')
      .then(function (r) { return r.json(); })
      .then(function (cart) {
        var items = cart.items || [];
        checkAndClearDiscount(items);
        var ids = items.map(function (i) { return String(i.product_id); });
        var variantIds = items.map(function (i) { return String(i.variant_id); });
        if (!ids.length) return;
        var hash = ids.join(',');

        if (cachedFunnels && hash === cachedCartHash) {
          // Filter out funnels whose offer variant is already in cart
          var available = cachedFunnels.filter(function (f) {
            return variantIds.indexOf(String(f.offerVariantId)) === -1;
          });
          if (!available.length) return;
          injectIntoDrawer(drawer, available);
          return;
        }

        fetch(APP_URL + '/api/funnels?shop=' + encodeURIComponent(SHOP) + '&placement=cart&productIds=' + hash)
          .then(function (r) { return r.json(); })
          .then(function (data) {
            var funnels = data.funnels || [];
            showPoweredBy = data.showPoweredBy !== false;
            if (data.buttonColor) buttonColor = data.buttonColor;
            if (data.buttonTextColor) buttonTextColor = data.buttonTextColor;
            if (data.widgetBgColor) widgetBgColor = data.widgetBgColor;
            if (data.widgetTitleColor) widgetTitleColor = data.widgetTitleColor;
            if (data.cardBgColor) cardBgColor = data.cardBgColor;
            cachedCartHash = hash;
            if (!funnels.length) { cachedFunnel = null; cachedFunnels = null; return; }
            cachedFunnel = funnels[0];
            cachedFunnels = funnels;
            // Filter out offers already in cart
            var available = funnels.filter(function (f) {
              return variantIds.indexOf(String(f.offerVariantId)) === -1;
            });
            if (!available.length) return;
            injectIntoDrawer(drawer, available);
          }).catch(function () {});
      }).catch(function () {});
  }

  // ── Watch document.body for any cart DOM changes ──
  function watchDrawer(drawer) {

    // Watch body — catches Horizon full re-renders of cart drawer contents
    var observer = new MutationObserver(function (mutations) {
      // Stand down while product-widget.js is updating the cart drawer DOM
      if (window._amoniProductUpdating) return;

      // Skip mutations caused by our own widget insertion
      for (var i = 0; i < mutations.length; i++) {
        var m = mutations[i];
        for (var j = 0; j < m.addedNodes.length; j++) {
          if (m.addedNodes[j].id === WIDGET_ID) return;
        }
        for (var j = 0; j < m.removedNodes.length; j++) {
          if (m.removedNodes[j].id === WIDGET_ID) {
            // Widget was removed externally — re-inject after a short pause
            clearTimeout(injectTimer);
            injectTimer = setTimeout(function () {
              if (!isInjecting && !window._amoniProductUpdating) fetchAndInject(drawer);
            }, 300);
            return;
          }
        }
      }
      clearTimeout(injectTimer);
      injectTimer = setTimeout(function () {
        if (!isInjecting && !window._amoniProductUpdating && !document.getElementById(WIDGET_ID)) fetchAndInject(drawer);
      }, 300);
    });
    observer.observe(document.body, { childList: true, subtree: true });

    // Reset on cart API events (add to cart etc.)
    ['cart:refresh', 'cart:updated', 'cart:change'].forEach(function (n) {
      document.addEventListener(n, function () {
        cachedCartHash = '';
        var existing = document.getElementById(WIDGET_ID);
        if (existing) existing.remove();
      });
    });

    // Poll every 3s as safety net — only if a funnel is known to exist
    setInterval(function () {
      if (cachedFunnel && !document.getElementById(WIDGET_ID) && !window._amoniProductUpdating) {
        fetchAndInject(drawer);
      }
    }, 3000);

    // Try injecting immediately
    fetchAndInject(drawer);
  }

  // ── Find cart drawer element by trying multiple selectors ──
  function findCartDrawer() {
    var selectors = [
      'cart-drawer',
      'cart-notification',
      'cart-items',
      'side-cart',
      '[id*="cart-drawer"]',
      '[id*="CartDrawer"]',
      '[class*="cart-drawer"]',
      '[class*="CartDrawer"]',
      '[data-cart-drawer]',
      'dialog[id*="cart"]',
      'aside[id*="cart"]',
      'section[id*="cart"]',
    ];
    // Words that indicate a sub-element, not the main drawer container
    // Note: avoid 'open'/'close' — main drawer div often has class 'cart-drawer--is-open'
    var SKIP = ['__header', '__toggle', '__trigger', '__overlay', '__backdrop', '__close', '-heading', '-header'];
    for (var i = 0; i < selectors.length; i++) {
      var els = document.querySelectorAll(selectors[i]);
      for (var j = 0; j < els.length; j++) {
        var el = els[j];
        var id = (el.id || '').toLowerCase();
        var cls = (typeof el.className === 'string' ? el.className : '').toLowerCase();
        var combined = id + ' ' + cls;
        var skip = false;
        for (var k = 0; k < SKIP.length; k++) {
          if (combined.indexOf(SKIP[k]) !== -1) { skip = true; break; }
        }
        if (!skip) {
          return el;
        }
      }
    }
    return null;
  }

  // ── Start when DOM is ready ──
  function init() {
    var drawer = findCartDrawer();
    if (drawer) {
      watchDrawer(drawer);
    } else {
      var bodyObserver = new MutationObserver(function (mutations) {
        var d = findCartDrawer();
        if (d) {
          bodyObserver.disconnect();
          watchDrawer(d);
        }
      });
      bodyObserver.observe(document.body, { childList: true, subtree: true });
    }
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', init);
  } else {
    init();
  }
})();
</script>

{% schema %}
{
  "name": "Amoni Upsell",
  "target": "body",
  "settings": []
}
{% endschema %}
