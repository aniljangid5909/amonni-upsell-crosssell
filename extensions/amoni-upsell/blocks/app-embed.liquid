{% comment %} Amoni Upsell — injects offer inside cart drawer {% endcomment %}
<div id="amoni-embed-root"
  data-shop="{{ shop.permanent_domain }}"
  data-app-url="https://amoni-upsell-cross-sell.vercel.app"
  style="display:none;"></div>

<script>
(function () {
  var root = document.getElementById('amoni-embed-root');
  if (!root) return;
  var SHOP = root.dataset.shop;
  var APP_URL = root.dataset.appUrl;
  var WIDGET_ID = 'amoni-drawer-offer';
  var cachedFunnel = null;
  var cachedCartHash = '';
  var isInjecting = false;
  var injectTimer = null;

  // ── Toast notification ──
  function showToast(title, imageUrl) {
    var old = document.getElementById('amoni-cart-toast');
    if (old) old.remove();
    if (!document.getElementById('amoni-toast-style')) {
      var s = document.createElement('style');
      s.id = 'amoni-toast-style';
      s.textContent =
        '@keyframes amoniIn{from{opacity:0;transform:translateY(-14px)}to{opacity:1;transform:translateY(0)}}' +
        '@keyframes amoniOut{from{opacity:1}to{opacity:0;transform:translateY(-14px)}}';
      document.head.appendChild(s);
    }
    var t = document.createElement('div');
    t.id = 'amoni-cart-toast';
    t.style.cssText = 'position:fixed;top:20px;right:20px;z-index:2147483647;background:#fff;border-radius:14px;box-shadow:0 8px 32px rgba(0,0,0,0.18);padding:16px 20px;display:flex;align-items:center;gap:14px;max-width:340px;width:calc(100vw - 40px);font-family:inherit;animation:amoniIn 0.3s ease;';
    t.innerHTML =
      (imageUrl ? '<img src="' + imageUrl + '" style="width:52px;height:52px;border-radius:8px;object-fit:cover;flex-shrink:0;" />' : '<div style="width:52px;height:52px;border-radius:8px;background:#f0f0f0;flex-shrink:0;"></div>') +
      '<div style="flex:1;min-width:0;">' +
        '<div style="font-size:13px;color:#888;margin-bottom:2px;">Added to cart</div>' +
        '<div style="font-size:14px;font-weight:600;color:#1a1a1a;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;">' + (title || 'Item') + '</div>' +
        '<div style="display:flex;gap:8px;margin-top:8px;">' +
          '<a href="/cart" style="flex:1;text-align:center;padding:7px 0;background:#1a1a1a;color:#fff;border-radius:8px;font-size:13px;font-weight:600;text-decoration:none;">View cart</a>' +
          '<button id="amoni-toast-close" style="flex:1;padding:7px 0;background:#f3f3f3;color:#333;border:none;border-radius:8px;font-size:13px;font-weight:600;cursor:pointer;">Continue</button>' +
        '</div>' +
      '</div>';
    document.body.appendChild(t);
    document.getElementById('amoni-toast-close').onclick = function () { dismissToast(t); };
    setTimeout(function () { dismissToast(t); }, 5000);
  }
  function dismissToast(t) {
    if (!t || !t.parentNode) return;
    t.style.animation = 'amoniOut 0.3s ease forwards';
    setTimeout(function () { if (t.parentNode) t.remove(); }, 300);
  }

  function refreshBadge() {
    // Update cart badge count
    fetch('/cart.js').then(function (r) { return r.json(); }).then(function (c) {
      document.querySelectorAll('cart-count,[data-cart-count],.cart-count,#cart-count,.CartCount,.cart-item-count')
        .forEach(function (b) { b.textContent = c.item_count; });
    }).catch(function () {});

    // Try Horizon section re-render
    var cartComp = document.querySelector('cart-items-component[data-section-id]') ||
                   document.querySelector('[data-cart-drawer][data-section-id]');
    var rawSectionId = cartComp && cartComp.dataset.sectionId;
    // data-section-id = "sections--12345__handle" → extract "handle" for /?sections= API
    var sectionHandle = rawSectionId ? rawSectionId.replace(/^[^_]*__/, '') : null;
    // Fallback: try known Horizon/common section handles
    var handles = sectionHandle ? [sectionHandle] : ['cart-drawer', 'header', 'cart'];
    console.error('[AMONI UPSELL] refreshing cart, handle=' + handles[0]);

    (function tryNextHandle(i) {
      if (i >= handles.length) {
        // All section fetches failed — close and reopen cart drawer to force Horizon re-render
        var dialog = document.querySelector('dialog[class*="cart"],dialog[id*="cart"],.dialog-drawer[open]');
        if (dialog && dialog.open) {
          dialog.close();
          setTimeout(function () {
            var openBtn = document.querySelector('[aria-controls$="cart"],[aria-controls*="CartDrawer"],[data-cart-toggle]');
            if (!openBtn) openBtn = document.querySelector('a[href="/cart"]');
            if (openBtn) openBtn.click();
          }, 200);
        }
        return;
      }
      fetch('/?sections=' + encodeURIComponent(handles[i]))
        .then(function (r) { return r.json(); })
        .then(function (sections) {
          var html = sections[handles[i]];
          if (!html) { tryNextHandle(i + 1); return; }
          var tmp = document.createElement('div');
          tmp.innerHTML = html;
          var sel = '[class*="cart-items_wrapper"],[class*="cart-items-wrapper"],[class*="CartItems"],.cart-items__wrapper';
          var newWrap = tmp.querySelector(sel);
          var oldWrap = document.querySelector(sel);
          if (newWrap && oldWrap) {
            oldWrap.innerHTML = newWrap.innerHTML;
            console.error('[AMONI UPSELL] cart items re-rendered via section=' + handles[i]);
          } else {
            tryNextHandle(i + 1);
          }
        }).catch(function () { tryNextHandle(i + 1); });
    })(0);

    // Dispatch generic cart events
    ['cart:refresh', 'cart:updated', 'cart:change'].forEach(function (n) {
      document.dispatchEvent(new CustomEvent(n, { bubbles: true }));
      window.dispatchEvent(new CustomEvent(n, { bubbles: true }));
    });
    if (cartComp) cartComp.dispatchEvent(new CustomEvent('cart:refresh', { bubbles: true }));
  }

  // ── Build widget HTML and attach button listener ──
  function buildWidget(funnel) {
    var offerPrice = parseFloat(funnel.offerPrice) || 0;
    var discounted =
      funnel.discountType === 'percent' ? offerPrice * (1 - (parseFloat(funnel.discountValue) || 0) / 100) :
      funnel.discountType === 'fixed'   ? offerPrice - (parseFloat(funnel.discountValue) || 0) : offerPrice;

    var heading =
      funnel.offerType === 'cross-sell' ? 'You might also like' :
      funnel.offerType === 'upsell'     ? 'Upgrade your order'  :
                                          'Frequently bought together';

    var subtext =
      funnel.discountType === 'percent' && funnel.discountValue > 0 ? 'Save ' + funnel.discountValue + '% on this offer' :
      funnel.discountType === 'fixed'   && funnel.discountValue > 0 ? 'Save $' + funnel.discountValue + ' on this offer' : '';

    var btnLabel =
      funnel.offerType === 'cross-sell' ? 'Add to cart' :
      funnel.offerType === 'upsell'     ? 'Upgrade now'  : 'Add both';

    var wrapper = document.createElement('div');
    wrapper.id = WIDGET_ID;
    wrapper.style.cssText = 'padding:12px 16px;border-top:1px solid #f0f0f0;background:#fdf5f2;';
    wrapper.innerHTML =
      '<div style="font-size:10px;font-weight:700;color:#b05e42;text-transform:uppercase;letter-spacing:0.05em;margin-bottom:8px;">' + heading + '</div>' +
      (subtext ? '<div style="font-size:12px;color:#b05e42;margin-bottom:8px;">' + subtext + '</div>' : '') +
      '<div style="display:flex;gap:10px;align-items:center;">' +
        (funnel.offerImageUrl
          ? '<img src="' + funnel.offerImageUrl + '" style="width:52px;height:52px;border-radius:8px;object-fit:cover;border:1px solid rgba(0,0,0,0.08);flex-shrink:0;" />'
          : '<div style="width:52px;height:52px;border-radius:8px;background:#e8e8e8;flex-shrink:0;"></div>') +
        '<div style="flex:1;min-width:0;">' +
          '<div style="font-size:13px;font-weight:600;color:#1a1a1a;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;">' + (funnel.offerTitle || '') + '</div>' +
          '<div style="font-size:14px;font-weight:700;color:#1a1a1a;">' +
            '$' + discounted.toFixed(2) +
            (funnel.discountValue > 0 ? ' <span style="font-size:12px;color:#aaa;text-decoration:line-through;">$' + offerPrice.toFixed(2) + '</span>' : '') +
          '</div>' +
        '</div>' +
        '<button data-amoni-add style="padding:9px 14px;border-radius:8px;border:none;background:#c8745a;color:#fff;font-weight:700;font-size:13px;cursor:pointer;white-space:nowrap;font-family:inherit;flex-shrink:0;">' + btnLabel + '</button>' +
      '</div>';

    var btn = wrapper.querySelector('[data-amoni-add]');
    btn.addEventListener('click', function () {
      if (!funnel.offerVariantId) return;
      btn.textContent = 'Adding...';
      btn.disabled = true;
      fetch('/cart/add.js', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ id: parseInt(funnel.offerVariantId, 10), quantity: 1 }),
      })
        .then(function (r) { if (!r.ok) throw new Error(); })
        .then(function () {
          if (funnel.discountCode) {
            return fetch('/cart/update.js', {
              method: 'POST', headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ discount: funnel.discountCode }),
            });
          }
        })
        .then(function () {
          btn.textContent = '✓ Added!';
          btn.style.background = '#0c8a4f';
          fetch(APP_URL + '/api/events', {
            method: 'POST', headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ funnelId: funnel.id, shop: SHOP, eventType: 'accept' }),
          });
          showToast(funnel.offerTitle || 'Item', funnel.offerImageUrl || '');
          refreshBadge();
        })
        .catch(function () { btn.textContent = 'Error'; btn.disabled = false; });
    });

    return wrapper;
  }

  // ── Find the cart summary/footer container to insert widget before it ──
  function findFooterAnchor() {
    // Target the summary block (above discount/totals/checkout), not a child element
    return (
      document.querySelector('[class*="cart-drawer__summary"]') ||
      document.querySelector('[class*="cart__summary"]') ||
      document.querySelector('[class*="cart-summary"]') ||
      document.querySelector('[class*="cart-drawer__footer"]') ||
      document.querySelector('[class*="cart__footer"]') ||
      document.querySelector('[class*="cart-footer"]') ||
      document.querySelector('cart-drawer-footer') ||
      document.querySelector('#cart-discount-disclosure')
    );
  }

  // ── Insert widget above the Discount/footer area ──
  function injectIntoDrawer(drawer, funnel) {
    if (isInjecting) return;
    if (document.getElementById(WIDGET_ID)) return;

    var footer = findFooterAnchor();

    console.error('[AMONI UPSELL] footer=' + (footer ? footer.tagName + '#' + footer.id + '.' + (typeof footer.className === 'string' ? footer.className : '').substring(0,30) : 'null'));

    // If footer not found yet, bail — MutationObserver will retry
    if (!footer) return;

    isInjecting = true;
    var widget = buildWidget(funnel);

    // Insert before the footer (puts widget between cart items and discount/checkout)
    var footerParent = footer.parentNode;
    footerParent.insertBefore(widget, footer);
    console.error('[AMONI UPSELL] widget inserted before ' + footer.id + ' inside ' + footerParent.tagName + '#' + footerParent.id + ' inDOM=' + !!document.getElementById(WIDGET_ID));

    fetch(APP_URL + '/api/events', {
      method: 'POST', headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ funnelId: funnel.id, shop: SHOP, eventType: 'impression' }),
    });

    isInjecting = false;
  }

  // ── Fetch funnel and inject ──
  function fetchAndInject(drawer) {
    fetch('/cart.js')
      .then(function (r) { return r.json(); })
      .then(function (cart) {
        var ids = (cart.items || []).map(function (i) { return String(i.product_id); });
        console.error('[AMONI UPSELL] cart items=' + JSON.stringify(ids));
        if (!ids.length) return;
        var hash = ids.join(',');

        if (cachedFunnel && hash === cachedCartHash) {
          injectIntoDrawer(drawer, cachedFunnel);
          return;
        }

        fetch(APP_URL + '/api/funnels?shop=' + encodeURIComponent(SHOP) + '&placement=cart&productIds=' + hash)
          .then(function (r) { return r.json(); })
          .then(function (data) {
            console.error('[AMONI UPSELL] funnels=' + JSON.stringify(data.funnels ? data.funnels.length : 'none'));
            var funnels = data.funnels || [];
            if (!funnels.length) return;
            cachedFunnel = funnels[0];
            cachedCartHash = hash;
            injectIntoDrawer(drawer, cachedFunnel);
          }).catch(function (e) { console.error('[AMONI UPSELL] funnels error: ' + e); });
      }).catch(function () {});
  }

  // ── Watch document.body for any cart DOM changes ──
  function watchDrawer(drawer) {
    console.error('[AMONI UPSELL] watching body for cart changes...');

    // Watch body — catches Horizon full re-renders of cart drawer contents
    var observer = new MutationObserver(function (mutations) {
      // Skip mutations caused by our own widget insertion
      for (var i = 0; i < mutations.length; i++) {
        var m = mutations[i];
        for (var j = 0; j < m.addedNodes.length; j++) {
          if (m.addedNodes[j].id === WIDGET_ID) return;
        }
        for (var j = 0; j < m.removedNodes.length; j++) {
          if (m.removedNodes[j].id === WIDGET_ID) {
            // Widget was removed externally — re-inject immediately
            clearTimeout(injectTimer);
            injectTimer = setTimeout(function () {
              if (!isInjecting) fetchAndInject(drawer);
            }, 150);
            return;
          }
        }
      }
      clearTimeout(injectTimer);
      injectTimer = setTimeout(function () {
        if (!isInjecting && !document.getElementById(WIDGET_ID)) fetchAndInject(drawer);
      }, 150);
    });
    observer.observe(document.body, { childList: true, subtree: true });

    // Reset on cart API events (add to cart etc.)
    ['cart:refresh', 'cart:updated', 'cart:change'].forEach(function (n) {
      document.addEventListener(n, function () {
        cachedCartHash = '';
        var existing = document.getElementById(WIDGET_ID);
        if (existing) existing.remove();
      });
    });

    // Also poll every 2s as safety net
    setInterval(function () {
      if (!document.getElementById(WIDGET_ID)) {
        fetchAndInject(drawer);
      }
    }, 2000);

    // Try injecting immediately
    fetchAndInject(drawer);
  }

  // ── Find cart drawer element by trying multiple selectors ──
  function findCartDrawer() {
    var selectors = [
      'cart-drawer',
      'cart-notification',
      'cart-items',
      'side-cart',
      '[id*="cart-drawer"]',
      '[id*="CartDrawer"]',
      '[class*="cart-drawer"]',
      '[class*="CartDrawer"]',
      '[data-cart-drawer]',
      'dialog[id*="cart"]',
      'aside[id*="cart"]',
      'section[id*="cart"]',
    ];
    // Words that indicate a sub-element, not the main drawer container
    // Note: avoid 'open'/'close' — main drawer div often has class 'cart-drawer--is-open'
    var SKIP = ['__header', '__toggle', '__trigger', '__overlay', '__backdrop', '__close', '-heading', '-header'];
    for (var i = 0; i < selectors.length; i++) {
      var els = document.querySelectorAll(selectors[i]);
      for (var j = 0; j < els.length; j++) {
        var el = els[j];
        var id = (el.id || '').toLowerCase();
        var cls = (typeof el.className === 'string' ? el.className : '').toLowerCase();
        var combined = id + ' ' + cls;
        var skip = false;
        for (var k = 0; k < SKIP.length; k++) {
          if (combined.indexOf(SKIP[k]) !== -1) { skip = true; break; }
        }
        if (!skip) {
          console.error('[AMONI UPSELL] cart element found: ' + selectors[i] + ' tag=' + el.tagName + ' id=' + el.id + ' class=' + cls.substring(0, 60));
          return el;
        }
      }
    }
    return null;
  }

  // ── Start when DOM is ready ──
  function init() {
    console.error('[AMONI UPSELL] script running, shop=' + SHOP);
    var drawer = findCartDrawer();
    if (drawer) {
      watchDrawer(drawer);
    } else {
      console.error('[AMONI UPSELL] no cart element found — watching body for changes');
      // Log all custom elements in body to help identify cart element
      var allTags = {};
      document.body.querySelectorAll('*').forEach(function(el) {
        if (el.tagName.indexOf('-') !== -1) allTags[el.tagName.toLowerCase()] = true;
      });
      console.error('[AMONI UPSELL] custom elements on page: ' + Object.keys(allTags).join(', '));

      var bodyObserver = new MutationObserver(function (mutations) {
        mutations.forEach(function(m) {
          m.addedNodes.forEach(function(node) {
            if (node.nodeType === 1) {
              console.error('[AMONI UPSELL] node added: ' + node.tagName + ' id=' + node.id);
            }
          });
        });
        var d = findCartDrawer();
        if (d) {
          bodyObserver.disconnect();
          watchDrawer(d);
        }
      });
      bodyObserver.observe(document.body, { childList: true, subtree: true });
    }
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', init);
  } else {
    init();
  }
})();
</script>

{% schema %}
{
  "name": "Amoni Upsell",
  "target": "body",
  "settings": []
}
{% endschema %}
