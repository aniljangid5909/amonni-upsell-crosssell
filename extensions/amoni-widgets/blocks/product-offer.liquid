{% comment %} Amoni Product Page "Frequently Bought Together" Widget {% endcomment %}
<div id="amoni-product-offer"
  data-shop="{{ shop.permanent_domain }}"
  data-product-id="{{ product.id }}"
  style="display:none; background:#fff; border-radius:14px; padding:20px; box-shadow:0 8px 28px rgba(0,0,0,0.08); margin:20px 0;">
  <div style="font-weight:700; font-size:15px; color:#1a1a1a; margin-bottom:4px;">Frequently bought together</div>
  <div id="amoni-product-offer-content"></div>
</div>
<script src="{{ 'product-widget.js' | asset_url }}" defer></script>
